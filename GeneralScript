-- Функция запуска скрипта по URL
local function runScript(url, label)
    if not url or url:find("example.com") then
        Rayfield:Notify({
            Title = "Blackbox Hub",
            Content = "URL для " .. label .. " не настроен. Вставь свой.",
            Duration = 4,
            Image = 4483362458,
        })
        return
    end

    local ok, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if ok then
        Rayfield:Notify({
            Title = "Успех",
            Content = label .. " загружен.",
            Duration = 3,
            Image = 4483362458,
        })
    else
        Rayfield:Notify({
            Title = "Ошибка",
            Content = label .. ": " .. tostring(err):sub(1, 60),
            Duration = 5,
            Image = 4483362458,
        })
    end
end

